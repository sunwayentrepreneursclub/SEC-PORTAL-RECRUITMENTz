<div id="setupWarn" class="setup-warn hidden">⚠ SHEETS_API_URL not configured. Open index.html and set your Apps Script URL.</div>

<script>
'use strict';

// ─── CONFIG ──────────────────────────────────────────────────────────────────
const SHEETS_API_URL = "https://script.google.com/macros/s/AKfycbzwv_LbQGxZM_QCdGdgWSsJc-asexbhLd8vgwlo3rPFNLFUpMw8IFIyVsEKID1tyI4Q/exec";
const esc = s => String(s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");

// ─── STATE ────────────────────────────────────────────────────────────────────
let state = {
  view: "recruit-home",
  selectedRole: null,
  roleFilter: "All",
  user: null,
  token: null,
  progress: null,
  adminKey: null,
  activeSubjectId: null,
  activeSectionId: null,
  quizAnswers: [],
  quizKey: null,
  quizQuestions: [],
  quizCurrentQ: 0,
  quizSubmitted: false,
  quizResults: null,
  quizStart: null,
  fastRead: false,
  readTimer: null,
  readTimerInterval: null,
  adminTab: "members",
  adminData: null,
  adminApps: null,
  generatedQuestions: null,
};

// Restore session
try {
  state.token = sessionStorage.getItem("sec_token");
  state.user = JSON.parse(sessionStorage.getItem("sec_user")||"null");
  state.adminKey = sessionStorage.getItem("sec_admin_key");
  if (state.token && state.user) state.view = "dashboard";
} catch(e) {}

// ─── API ──────────────────────────────────────────────────────────────────────
async function api(body) {
  if (!SHEETS_API_URL || SHEETS_API_URL.includes("PASTE_YOUR")) {
    document.getElementById("setupWarn").classList.remove("hidden");
    throw new Error("API not configured");
  }
  if (state.token) body.token = state.token;
  const res = await fetch(SHEETS_API_URL, {
    method: "POST",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify(body)
  });
  const json = await res.json();
  if (json.error) throw new Error(json.error);
  return json;
}

// ─── TOAST ────────────────────────────────────────────────────────────────────
let toastTimer;
function showToast(msg, type="") {
  const el = document.getElementById("toast");
  el.textContent = msg;
  el.className = "toast show" + (type ? " "+type : "");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.className = "toast", 3500);
}

// ─── PANEL ────────────────────────────────────────────────────────────────────
function openPanel(html) {
  document.getElementById("slidePanel").innerHTML = html;
  document.getElementById("slidePanel").classList.add("open");
  document.getElementById("panelOverlay").classList.add("open");
  document.getElementById("panelOverlay").onclick = closePanel;
  const closeBtn = document.getElementById("panelCloseBtn");
  if (closeBtn) closeBtn.onclick = closePanel;
}
function closePanel() {
  document.getElementById("slidePanel").classList.remove("open");
  document.getElementById("panelOverlay").classList.remove("open");
}

// ─── RENDER ───────────────────────────────────────────────────────────────────
function render() {
  clearInterval(state.readTimerInterval);
  const app = document.getElementById("app");
  app.innerHTML = renderTopnav() + renderView();
  attachEvents();
}

function renderView() {
  const v = state.view;
  if (v === "recruit-home")   return renderRecruitHome();
  if (v === "recruit-why")    return renderRecruitWhy();
  if (v === "recruit-standard") return renderRecruitStandard();
  if (v === "recruit-roles")  return renderRecruitRoles();
  if (v === "recruit-role-detail") return renderRoleDetail();
  if (v === "recruit-process") return renderRecruitProcess();
  if (v === "recruit-apply")  return renderRecruitApply();
  if (v === "login")          return renderLogin();
  if (v === "dashboard")      return renderDashboard();
  if (v === "subject")        return renderSubjectShell();
  if (v === "admin-dashboard") return renderAdminShell();
  return "<div style='padding:40px;'>View not found.</div>";
}

// ─── TOPNAV ───────────────────────────────────────────────────────────────────
function renderTopnav() {
  const isLearn = ["dashboard","subject","login"].includes(state.view);
  const isAdmin = state.view === "admin-dashboard";

  if (isAdmin) return `
    <nav class="topnav">
      <a class="brand" onclick="nav('recruit-home')">
        <div class="brand-mark"></div>
        <span class="brand-name">SEC</span>
      </a>
      <div class="nav-right">
        <span class="chip chip-amber">Admin Dashboard</span>
        <button class="btn btn-ghost btn-sm" id="adminLogoutBtn">Exit</button>
      </div>
    </nav>`;

  if (isLearn && state.user) return `
    <nav class="topnav">
      <a class="brand" onclick="nav('dashboard')">
        <div class="brand-mark"></div>
        <span class="brand-name">SEC Learning Portal</span>
      </a>
      <div class="nav-right">
        <span class="chip chip-amber">${esc(state.user.name.split(" ")[0])}</span>
        ${state.user.role ? `<span class="chip chip-muted">${esc(state.user.role)}</span>` : ""}
        <button class="btn btn-ghost btn-sm" id="logoutBtn">Sign out</button>
      </div>
    </nav>`;

  return `
    <nav class="topnav">
      <a class="brand" onclick="nav('recruit-home')">
        <div class="brand-mark"></div>
        <span class="brand-name">Sunway Entrepreneurs Club</span>
      </a>
      <div class="nav-links">
        <a class="nav-link" onclick="nav('recruit-why')">Why SEC</a>
        <a class="nav-link" onclick="nav('recruit-standard')">Our Standard</a>
        <a class="nav-link" onclick="nav('recruit-roles')">Roles</a>
        <a class="nav-link" onclick="nav('recruit-apply')">Apply</a>
      </div>
      <div class="nav-right">
        <button class="btn btn-ghost btn-sm" onclick="nav('login')">Committee Login →</button>
      </div>
    </nav>`;
}

// ─── NAVIGATION ───────────────────────────────────────────────────────────────
function nav(view, extra) {
  if (extra) Object.assign(state, extra);
  state.view = view;
  window.scrollTo(0,0);
