function renderDashboard() {
  const p = state.progress || {};
  const subs = SUBJECTS;
  const totalSections = subs.reduce((a,s) => a + s.sections.length, 0);
  const doneSections = subs.reduce((a,s) => {
    return a + s.sections.filter(sec => p.subjects?.[s.id]?.sections?.[sec.id]?.status === "complete").length;
  }, 0);
  const pct = totalSections ? Math.round((doneSections/totalSections)*100) : 0;

  return `
  <div class="learn-shell">
    <div class="learn-main" style="max-width:900px; margin:0 auto; padding:40px 32px;">
      <div style="margin-bottom:32px;">
        <div style="font-family:var(--serif); font-size:26px; font-weight:600; margin-bottom:6px;">Good ${greeting()}, ${esc((state.user?.name||"").split(" ")[0])}.</div>
        <div style="font-family:var(--mono); font-size:10.5px; color:var(--muted); text-transform:uppercase; letter-spacing:0.06em;">${esc(state.user?.role||"Committee Member")}</div>
      </div>
      <div style="background:var(--paper-raised); border:1px solid var(--line); border-radius:12px; padding:18px 22px; margin-bottom:32px; display:flex; align-items:center; gap:20px;">
        <div style="flex:1;">
          <div style="font-size:13px; font-weight:600; margin-bottom:8px;">Overall progress — ${doneSections} of ${totalSections} sections complete</div>
          <div class="progress-track" style="height:7px;"><div class="progress-fill" style="width:${pct}%"></div></div>
        </div>
        <div style="font-family:var(--serif); font-size:24px; font-weight:700; color:${pct===100?"var(--green)":"var(--amber-deep)"};">${pct}%</div>
      </div>
      <div class="dash-subjects">
        ${subs.map(sub => subjectCard(sub, p)).join("")}
      </div>
    </div>
  </div>`;
}

function subjectCard(sub, p) {
  const total = sub.sections.length;
  const done = sub.sections.filter(s => p.subjects?.[sub.id]?.sections?.[s.id]?.status === "complete").length;
  const pct = total ? Math.round((done/total)*100) : 0;
  const status = done===total ? "complete" : done>0 ? "progress" : "new";
  const chipMap = { complete:"chip-green", progress:"chip-amber", new:"chip-muted" };
  const labelMap = { complete:"Complete", progress:"In progress", new:"Not started" };
  const ring = progressRing(pct, 52);

  return `
  <div class="subject-card" onclick="openSubject('${sub.id}')">
    <div class="subject-card-top">
      <div>
        <div class="subject-title">${esc(sub.title)}</div>
        <span class="chip ${chipMap[status]}">${labelMap[status]}</span>
      </div>
      ${ring}
    </div>
    <div class="subject-desc">${esc(sub.description)}</div>
    <div class="subject-meta">${total} sections · ~${sub.estimatedMinutes} min</div>
    <div class="subject-card-footer">
      <div style="font-size:12px; color:var(--muted);">${done}/${total} sections passed</div>
      <button class="btn btn-primary btn-sm">${done===0?"Start":"Continue"} →</button>
    </div>
  </div>`;
}

function progressRing(pct, size) {
  const r = (size-8)/2, circ = 2*Math.PI*r;
  const offset = circ - (pct/100)*circ;
  return `
  <div class="ring-wrap" style="width:${size}px;height:${size}px;">
    <svg width="${size}" height="${size}">
      <circle class="ring-track" cx="${size/2}" cy="${size/2}" r="${r}" stroke-width="5"/>
      <circle class="ring-fill" cx="${size/2}" cy="${size/2}" r="${r}" stroke-width="5"
        stroke-dasharray="${circ}" stroke-dashoffset="${offset}"/>
    </svg>
    <div class="ring-text">${pct}%</div>
  </div>`;
}

function renderSubjectShell() {
  const sub = SUBJECTS.find(s => s.id === state.activeSubjectId);
  if (!sub) return renderDashboard();
  const p = state.progress || {};
  const secItems = sub.sections.map((s,i) => {
    const done = p.subjects?.[sub.id]?.sections?.[s.id]?.status === "complete";
    const active = s.id === state.activeSectionId;
    return `
    <li class="sec-item ${active?"active":""}" onclick="openSection('${sub.id}','${s.id}')">
      <div class="sec-dot ${done?"done":""}"></div>
      <div>
        <div class="sec-title">${esc(s.title)}</div>
        <span class="sec-status">${done?"Passed":"Not completed"}</span>
      </div>
    </li>`;
  }).join("");

  return `
  <div class="learn-shell">
    <div class="learn-sidebar">
      <div class="sidebar-header">
        <div style="cursor:pointer;font-size:12px;color:var(--muted);margin-bottom:10px;" onclick="nav('dashboard')">← Dashboard</div>
        <div class="sidebar-greeting">${esc(sub.title)}</div>
      </div>
      <ul class="sec-list">${secItems}</ul>
    </div>
    <div class="learn-main">${renderSectionContent()}</div>
  </div>`;
}

function renderSectionContent() {
  if (state.quizSubmitted && state.quizResults) return renderResult();
  if (state.quizQuestions.length > 0) return renderQuiz();
  return renderReader();
}

function renderReader() {
  const sub = SUBJECTS.find(s => s.id === state.activeSubjectId);
  const sec = sub?.sections.find(s => s.id === state.activeSectionId);
  if (!sec) return "<div>Section not found.</div>";
  const wordCount = sec.clauses.reduce((a,c) => a + c.text.split(" ").length, 0);
  const timerSec = Math.min(120, Math.max(30, Math.ceil(wordCount/200)*60));

  return `
  <div>
    <div class="reader-eyebrow">Section ${SUBJECTS.flatMap(s=>s.sections).findIndex(s=>s.id===sec.id)+1} of ${SUBJECTS.reduce((a,s)=>a+s.sections.length,0)} · Verbatim from SEC Charter 2026–2027</div>
    <h1 class="reader-h1">${esc(sec.title)}</h1>
    <div class="reader-body" id="readerBody">
      ${sec.clauses.map(c => `
        <div class="clause-block">
          <div class="clause-label">${esc(c.label)}</div>
          ${c.text.split("\n\n").map(para => `<p>${esc(para)}</p>`).join("")}
        </div>`).join("")}
    </div>
    <div class="gate-banner" id="gateBanner">
      <span>Read the section above. Comprehension check unlocks in <span class="gate-timer" id="gateTimer">${timerSec}</span>s.</span>
    </div>
    <div class="reader-actions">
      <button class="btn btn-primary" id="startQuizBtn" disabled>Take comprehension check</button>
    </div>
  </div>`;
}

function renderQuiz() {
  const qi = state.quizCurrentQ;
  const q = state.quizQuestions[qi];
  const total = state.quizQuestions.length;
  const pct = Math.round((qi/total)*100);
  const selected = state.quizAnswers[qi];

  const opts = q.options.map((opt, oi) => {
    const letter = String.fromCharCode(65+oi);
    const sel = selected === oi;
    return `
    <div class="opt ${sel?"selected":""}" onclick="selectOpt(${oi})">
      <div class="opt-letter">${letter}</div>
      <div>${esc(opt)}</div>
    </div>`;
  }).join("");

  const isLast = qi === total - 1;
  const canNext = selected !== undefined;

  return `
  <div>
    <div class="reader-eyebrow">Comprehension Check</div>
    <div style="margin-bottom:20px;">
      <div class="q-counter">${qi+1} of ${total} questions</div>
      <div class="quiz-progress-bar"><div class="quiz-progress-fill" style="width:${pct}%"></div></div>
    </div>
    <div class="q-card">
      <div class="q-text">${esc(q.q)}</div>
      ${opts}
    </div>
    <div class="quiz-actions" style="margin-top:20px;">
      ${isLast
        ? `<button class="btn btn-primary" id="submitQuizBtn" ${canNext?"":"disabled"}>Submit answers</button>`
        : `<button class="btn btn-primary" id="nextQBtn" ${canNext?"":"disabled"}>Next →</button>`}
      <button class="btn btn-ghost" onclick="cancelQuiz()">Back to reading</button>
    </div>
  </div>`;
}

function renderResult() {
  const r = state.quizResults;
  const passed = r.passed;
  const sub = SUBJECTS.find(s => s.id === state.activeSubjectId);
  const secIdx = sub?.sections.findIndex(s => s.id === state.activeSectionId) ?? -1;
  const nextSec = sub?.sections[secIdx + 1];

  return `
  <div>
    <div class="result-banner">
      <div style="font-family:var(--mono);font-size:11px;color:var(--muted);margin-bottom:6px;">RESULT</div>
      <div class="result-score ${passed?"result-pass":"result-fail"}">${r.score}/${r.total}</div>
      <div style="font-family:var(--mono);font-size:12px;color:var(--muted);">${passed?"Passed ✓":"Below 80% threshold"}</div>
      <div class="result-msg">${passed
        ? "You've demonstrated understanding of this section. It's marked complete."
        : "Re-read the section and focus on the clauses you missed. The check re-locks until you re-read."}</div>

      ${r.results ? `
      <div style="text-align:left;margin:0 auto 24px;max-width:480px;">
        ${r.results.map((res,i) => res.explain ? `
          <div style="background:#fbeae6;border-radius:8px;padding:12px 14px;margin-bottom:8px;font-size:13px;color:#7a2c20;line-height:1.6;">
            <strong>Q${i+1}:</strong> ${esc(res.explain)}
          </div>` : "").join("")}
      </div>` : ""}

      <div class="result-actions">
        ${passed
          ? nextSec
            ? `<button class="btn btn-primary" onclick="openSection('${state.activeSubjectId}','${nextSec.id}')">Continue →</button>`
            : `<button class="btn btn-primary" onclick="nav('dashboard')">Back to dashboard</button>`
          : `<button class="btn btn-amber" onclick="retrySection()">Re-read section</button>`}
      </div>
    </div>
  </div>`;
}

