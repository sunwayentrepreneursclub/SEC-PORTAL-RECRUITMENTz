      renderMembersTab();
    } catch(e) {
      content.innerHTML = `<div class="alert alert-error">${esc(e.message)}</div>`;
    }
  } else if (state.adminTab === "applications") {
    content.innerHTML = "<div style='color:var(--muted);font-size:13px;'>Loading applications...</div>";
