// ─── READER TIMER ─────────────────────────────────────────────────────────────
function startReaderTimer() {
  const sub = SUBJECTS.find(s => s.id === state.activeSubjectId);
  const sec = sub?.sections.find(s => s.id === state.activeSectionId);
  if (!sec) return;

  // Skip timer if already passed
  if (state.progress?.subjects?.[state.activeSubjectId]?.sections?.[state.activeSectionId]?.status === "complete") {
    const btn = document.getElementById("startQuizBtn");
    if (btn) { btn.disabled = false; document.getElementById("gateBanner")?.remove(); }
    return;
  }

  const wordCount = sec.clauses.reduce((a,c) => a + c.text.split(" ").length, 0);
  let remaining = Math.min(120, Math.max(30, Math.ceil(wordCount/200)*60));
  state.readStart = Date.now();
  state.fastRead = false;

  // Scroll-based fast-read detection
  const body = document.getElementById("readerBody");
  if (body) {
    body.onscroll = () => {
      const elapsed = (Date.now() - state.readStart) / 1000;
      if (!state.fastRead && body.scrollTop + body.clientHeight >= body.scrollHeight - 50) {
        if (elapsed < remaining * 0.5) state.fastRead = true;
      }
    };
  }

  clearInterval(state.readTimerInterval);
  state.readTimerInterval = setInterval(() => {
    remaining--;
    const el = document.getElementById("gateTimer");
    if (el) el.textContent = remaining;
    if (remaining <= 0) {
      clearInterval(state.readTimerInterval);
      const btn = document.getElementById("startQuizBtn");
      const banner = document.getElementById("gateBanner");
      if (btn) btn.disabled = false;
      if (banner) banner.innerHTML = "You can now take the comprehension check.";
    }
  }, 1000);
}

// ─── QUIZ FLOW ────────────────────────────────────────────────────────────────
async function startQuiz() {
  clearInterval(state.readTimerInterval);
  try {
    const res = await api({ action:"getQuestions", subjectId:state.activeSubjectId, sectionId:state.activeSectionId });
    state.quizQuestions = res.questions;
    state.quizKey = res.quizKey;
    state.quizAnswers = [];
    state.quizCurrentQ = 0;
    state.quizSubmitted = false;
    state.quizResults = null;
    state.quizStart = Date.now();
    render();
  } catch(err) {
    showToast("Couldn't load questions: " + err.message, "error");
  }
}

function selectOpt(oi) {
  state.quizAnswers[state.quizCurrentQ] = oi;
  render();
}

function nextQuestion() {
  if (state.quizCurrentQ < state.quizQuestions.length - 1) {
    state.quizCurrentQ++;
    render();
  }
}

async function submitQuiz() {
  const answers = state.quizAnswers.map((ai, qi) => state.quizQuestions[qi].options[ai]);
  const timeSeconds = state.quizStart ? Math.round((Date.now()-state.quizStart)/1000) : 0;

  try {
    const res = await api({
      action:"grade",
      quizKey: state.quizKey,
      answers,
      subjectId: state.activeSubjectId,
      sectionId: state.activeSectionId,
      timeSeconds,
      fastRead: state.fastRead
    });
    state.quizResults = res;
    state.quizSubmitted = true;

    if (res.passed) {
      // Update local progress
      if (!state.progress) state.progress = { subjects:{} };
      if (!state.progress.subjects) state.progress.subjects = {};
      if (!state.progress.subjects[state.activeSubjectId]) state.progress.subjects[state.activeSubjectId] = { sections:{} };
      state.progress.subjects[state.activeSubjectId].sections[state.activeSectionId] = { status:"complete" };
    }
    render();
  } catch(err) {
    showToast("Couldn't submit: " + err.message, "error");
  }
}

function cancelQuiz() {
  state.quizQuestions = [];
  state.quizKey = null;
  state.quizAnswers = [];
  state.quizSubmitted = false;
  state.quizResults = null;
  render();
}

function retrySection() {
  state.quizQuestions = [];
  state.quizKey = null;
  state.quizAnswers = [];
  state.quizSubmitted = false;
  state.quizResults = null;
  render();
}

// ─── SUBJECT / SECTION OPENERS ────────────────────────────────────────────────
function openSubject(subId) {
  const sub = SUBJECTS.find(s => s.id === subId);
  if (!sub) return;
  const p = state.progress;
  // Find first incomplete section
  const firstIncomplete = sub.sections.find(s => !(p?.subjects?.[subId]?.sections?.[s.id]?.status === "complete"));
  const secId = firstIncomplete ? firstIncomplete.id : sub.sections[0].id;
  state.activeSubjectId = subId;
  state.activeSectionId = secId;
  state.quizQuestions = [];
  state.quizSubmitted = false;
  state.quizResults = null;
  nav("subject");
}

function openSection(subId, secId) {
  state.activeSubjectId = subId;
  state.activeSectionId = secId;
  state.quizQuestions = [];
  state.quizSubmitted = false;
  state.quizResults = null;
  state.quizAnswers = [];
  render();
}

function setFilter(f) {
  state.roleFilter = f;
  render();
}

