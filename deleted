    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      document.getElementById("qContent").value = "[PDF text extracted — note: plain FileReader reads PDF binary. For best results, paste the section text manually from the PDF.]";
    };
    reader.readAsText(file);
  };

  document.getElementById("generateBtn").onclick = generateQuestions;
}

async function generateQuestions() {
  const subjectId = document.getElementById("qSubject").value;
  const sectionId = document.getElementById("qSection").value;
  const content = document.getElementById("qContent").value.trim();
  const apiKey = document.getElementById("qApiKey").value.trim();
  const errBox = document.getElementById("qError");
  const btn = document.getElementById("generateBtn");

  if (!content) { errBox.textContent = "Paste section content first."; errBox.classList.remove("hidden"); return; }
  if (!apiKey) { errBox.textContent = "Enter your Gemini API key."; errBox.classList.remove("hidden"); return; }

  sessionStorage.setItem("gemini_key", apiKey);
  errBox.classList.add("hidden");
  btn.disabled = true; btn.textContent = "Generating with Gemini...";

  try {
    // Store key in Script Properties first
    await api({ action:"setProp", key:"GEMINI_API_KEY", value:apiKey, adminKey:state.adminKey });
    const sec = SUBJECTS.find(s=>s.id===subjectId)?.sections.find(s=>s.id===sectionId);
    const res = await api({ action:"generateQuestions", subjectId, sectionId, sectionTitle:sec?.title||sectionId, content, adminKey:state.adminKey });
    state.generatedQuestions = res.questions;
    renderQPreview(subjectId, sectionId, res.questions);
  } catch(e) {
    errBox.textContent = e.message; errBox.classList.remove("hidden");
  }
  btn.disabled = false; btn.textContent = "Generate questions with Gemini";
}

function renderQPreview(subjectId, sectionId, questions) {
  const preview = document.getElementById("qPreview");
  preview.innerHTML = `
    <div style="margin-top:28px; padding-top:24px; border-top:1px solid var(--line);">
      <div style="font-family:var(--mono);font-size:11px;font-weight:700;color:var(--amber-deep);text-transform:uppercase;margin-bottom:16px;">Review generated questions</div>
      ${questions.map((q,qi) => `
        <div style="background:var(--paper-raised);border:1px solid var(--line);border-radius:12px;padding:20px;margin-bottom:14px;">
          <div style="font-size:14px;font-weight:600;margin-bottom:14px;">${qi+1}. ${esc(q.q)}</div>
          ${q.options.map((opt,oi) => `
            <div style="padding:9px 14px;border-radius:8px;margin-bottom:6px;font-size:13px;background:${oi===q.correct?"var(--amber-pale)":"var(--paper)"};border:1px solid ${oi===q.correct?"var(--amber)":"var(--line)"};">
              ${String.fromCharCode(65+oi)}. ${esc(opt)} ${oi===q.correct?"<strong style='color:var(--amber-deep);'>(Correct)</strong>":""}
            </div>`).join("")}
          <div style="margin-top:10px;padding:10px;background:#e4ede6;border-radius:7px;font-size:12.5px;color:#2c4a35;">${esc(q.explain)}</div>
        </div>`).join("")}
      <button class="btn btn-primary" onclick="saveQuestions('${subjectId}','${sectionId}')" style="width:100%;padding:12px;">Approve & save to portal</button>
    </div>`;
}

async function saveQuestions(subjectId, sectionId) {
  try {
    await api({ action:"saveQuestions", subjectId, sectionId, questions:state.generatedQuestions, adminKey:state.adminKey });
    showToast("Questions saved! Members will see these questions for this section.", "success");
    document.getElementById("qPreview").innerHTML = `<div class="alert alert-success" style="margin-top:16px;">Questions saved successfully.</div>`;
  } catch(e) { showToast(e.message, "error"); }
}

function renderSettingsTab() {
  document.getElementById("adminTabContent").innerHTML = `
    <div style="max-width:500px; display:flex; flex-direction:column; gap:20px;">
      <div class="card" style="padding:24px;">
        <div style="font-size:15px;font-weight:700;margin-bottom:16px;">Passwords</div>
        <div class="field"><label>New club password (members)</label><input type="text" id="newClubPw" placeholder="Current: set in Script Properties"></div>
        <button class="btn btn-primary btn-sm" onclick="setProp('CLUB_PASSWORD','newClubPw')">Update club password</button>
      </div>
      <div class="card" style="padding:24px;">
        <div style="font-size:15px;font-weight:700;margin-bottom:16px;">Admin key</div>
        <div class="field"><label>New admin key</label><input type="text" id="newAdminKey" placeholder="Current: set in Script Properties"></div>
        <button class="btn btn-primary btn-sm" onclick="setProp('ADMIN_KEY','newAdminKey')">Update admin key</button>
      </div>
      <div class="card" style="padding:24px;">
        <div style="font-size:15px;font-weight:700;margin-bottom:8px;">Committee Register</div>
        <p style="font-size:13px;color:var(--muted);margin-bottom:16px;">Add committee emails here to restrict Learning Portal access. If empty, any email can log in.</p>
        <div style="display:flex;gap:8px;margin-bottom:14px;">
          <input type="email" id="regEmail" placeholder="email@example.com" style="flex:1;padding:10px 14px;border:1.5px solid var(--line);border-radius:8px;font-family:var(--sans);font-size:13px;background:var(--paper);outline:none;">
          <input type="text" id="regName" placeholder="Full name" style="flex:1;padding:10px 14px;border:1.5px solid var(--line);border-radius:8px;font-family:var(--sans);font-size:13px;background:var(--paper);outline:none;">
          <input type="text" id="regRole" placeholder="Role (e.g. R-11)" style="width:100px;padding:10px 14px;border:1.5px solid var(--line);border-radius:8px;font-family:var(--sans);font-size:13px;background:var(--paper);outline:none;">
          <button class="btn btn-primary btn-sm" onclick="addToRegister()">Add</button>
        </div>
        <div id="regMsg"></div>
      </div>
      <div class="card" style="padding:24px;">
        <div style="font-size:15px;font-weight:700;margin-bottom:8px;">Setup checklist</div>
        <div style="font-size:13px;color:#3a3328;line-height:1.8;">
          ✅ Upload HTML to GitHub as <code>index.html</code><br>
          ✅ Apps Script deployed with "Anyone" access<br>
          ⬜ Set CLUB_PASSWORD in Script Properties<br>
          ⬜ Set ADMIN_KEY in Script Properties<br>
          ⬜ Add committee emails to Register tab in Sheet<br>
          ⬜ Archive old Apps Script deployments<br>
          ⬜ Set Gemini key via Question Generator tab<br>
          ⬜ Fill in [PLACEHOLDER] content in the HTML
        </div>
      </div>
    </div>`;
}

async function setProp(key, inputId) {
  const value = document.getElementById(inputId)?.value.trim();
  if (!value) { showToast("Enter a value first.", "error"); return; }
  try {
    await api({ action:"setProp", key, value, adminKey:state.adminKey });
    showToast(`${key} updated successfully.`, "success");
    document.getElementById(inputId).value = "";
  } catch(e) { showToast(e.message, "error"); }
}

async function addToRegister() {
  const email = document.getElementById("regEmail")?.value.trim();
  const name = document.getElementById("regName")?.value.trim();
  const role = document.getElementById("regRole")?.value.trim();
  if (!email || !name) { showToast("Email and name required.", "error"); return; }
  try {
    await api({ action:"addToRegister", email, name, role, adminKey:state.adminKey });
    showToast(`${name} (${email}) added to register.`, "success");
    document.getElementById("regEmail").value = "";
    document.getElementById("regName").value = "";
    document.getElementById("regRole").value = "";
  } catch(e) { showToast(e.message, "error"); }
}

// ─── INIT ─────────────────────────────────────────────────────────────────────
render();
</script>
</body>
</html>
