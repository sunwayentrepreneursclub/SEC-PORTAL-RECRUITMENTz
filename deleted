      const res = await api({ action:"loadApplications", adminKey:state.adminKey });
      state.adminApps = res.applications || [];
      renderApplicationsTab();
    } catch(e) {
      content.innerHTML = `<div class="alert alert-error">${esc(e.message)}</div>`;
