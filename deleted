function renderMembersTab() {
  const all = state.adminData || [];
  const totalSecs = SUBJECTS.reduce((a,s)=>a+s.sections.length,0);
  const cleared = all.filter(p => SUBJECTS.every(s => s.sections.every(sec => p.subjects?.[s.id]?.sections?.[sec.id]?.status==="complete"))).length;

  const rows = all.sort((a,b)=>(b.lastActive||0)-(a.lastActive||0)).map((p,idx) => {
    const done = SUBJECTS.reduce((a,s)=>a+s.sections.filter(sec=>p.subjects?.[s.id]?.sections?.[sec.id]?.status==="complete").length,0);
    const pct = totalSecs ? Math.round((done/totalSecs)*100) : 0;
    const status = done===totalSecs?"complete":done>0?"progress":"new";
    const chipClass = {complete:"chip-green",progress:"chip-amber",new:"chip-muted"}[status];
    const chipLabel = {complete:"Complete",progress:"In progress",new:"Not started"}[status];
    const totalAttempts = SUBJECTS.reduce((a,s)=>a+s.sections.reduce((b,sec)=>b+(p.subjects?.[s.id]?.sections?.[sec.id]?.attempts?.length||0),0),0);
    const fastReads = SUBJECTS.reduce((a,s)=>a+s.sections.reduce((b,sec)=>{
      const atts = p.subjects?.[s.id]?.sections?.[sec.id]?.attempts||[];
      return b + atts.filter(at=>at.fastRead).length;
    },0),0);
    return `
    <tr class="clickable" data-idx="${idx}">
      <td><strong>${esc(p.name||"(no name)")}</strong><br><span style="font-family:var(--mono);font-size:11px;color:var(--muted);">${esc(p.email||"")}</span></td>
      <td>${esc(p.role||"—")}</td>
      <td><span class="mini-bar"><span class="mini-bar-fill" style="width:${pct}%"></span></span>${done}/${totalSecs}</td>
      <td><span class="chip ${chipClass}">${chipLabel}</span></td>
      <td style="font-family:var(--mono);font-size:12px;">${totalAttempts}</td>
      <td style="font-family:var(--mono);font-size:12px;">${fastReads>0?`<span style="color:var(--amber-deep);">⚡${fastReads}</span>`:"—"}</td>
      <td style="font-family:var(--mono);font-size:11px;color:var(--muted);">${p.lastActive?new Date(p.lastActive).toLocaleDateString():"—"}</td>
      <td><button class="btn btn-sm" style="background:transparent;border:1px solid var(--line);color:var(--muted);width:28px;padding:0;height:28px;" data-del="${esc(p.email||"")}">✕</button></td>
    </tr>`;
  }).join("");

  document.getElementById("adminTabContent").innerHTML = `
    <div class="stat-row">
      <div class="stat-card"><div class="stat-num">${all.length}</div><div class="stat-label">Members started</div></div>
      <div class="stat-card"><div class="stat-num">${cleared}</div><div class="stat-label">Fully cleared</div></div>
      <div class="stat-card"><div class="stat-num">${all.length-cleared}</div><div class="stat-label">In progress</div></div>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Member</th><th>Role</th><th>Sections</th><th>Status</th><th>Attempts</th><th>Fast reads</th><th>Last active</th><th></th></tr></thead>
        <tbody>${rows || `<tr><td colspan="8" style="text-align:center;color:var(--muted);padding:30px;">No members yet.</td></tr>`}</tbody>
      </table>
    </div>`;

  document.querySelectorAll("tr[data-idx]").forEach(row => {
    row.onclick = (e) => {
      if (e.target.dataset.del) return;
      openMemberPanel(state.adminData[parseInt(row.dataset.idx)]);
    };
  });
  document.querySelectorAll("[data-del]").forEach(btn => {
    btn.onclick = async (e) => {
      e.stopPropagation();
      const email = btn.dataset.del;
      if (!confirm(`Delete all progress for ${email}? This cannot be undone.`)) return;
      try {
        await api({ action:"deleteMember", email, adminKey:state.adminKey });
        showToast("Member deleted.", "success");
        loadAdminTab();
      } catch(err) { showToast(err.message, "error"); }
    };
  });
}

