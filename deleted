<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SEC — Sunway Entrepreneurs Club</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,300;0,600;0,700;1,300&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --ink: #1c1812;
  --paper: #f7f3ea;
  --paper-raised: #fffdf8;
  --amber: #c2761c;
  --amber-deep: #8a4e0f;
  --amber-pale: #f0dcb8;
  --line: #e2d7bf;
  --green: #3f6b4a;
  --red: #a13c2f;
  --muted: #7a7163;
  --mono: 'JetBrains Mono', monospace;
  --serif: 'Source Serif 4', Georgia, serif;
  --sans: 'Inter', -apple-system, sans-serif;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--sans);
  background: var(--paper);
  color: var(--ink);
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}
body::before {
  content: "";
  position: fixed; inset: 0; pointer-events: none; z-index: 0;
  background-image: radial-gradient(circle at 1px 1px, rgba(28,24,18,0.04) 1px, transparent 0);
  background-size: 24px 24px;
}
#app { position: relative; z-index: 1; min-height: 100vh; }

/* ── UTILITIES ───────────────────────────────────────────────────────────── */
.hidden { display: none !important; }
.esc-text { word-break: break-word; }

/* ── TOPNAV ──────────────────────────────────────────────────────────────── */
.topnav {
  position: sticky; top: 0; z-index: 100;
  background: rgba(247,243,234,0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 32px; height: 60px;
}
.brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
.brand-mark {
  width: 32px; height: 32px; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, var(--amber-pale), var(--amber) 55%, var(--amber-deep));
  position: relative; flex-shrink: 0;
}
.brand-mark::after {
  content: ""; position: absolute; inset: 7px; border-radius: 50%;
  border: 1.5px solid rgba(255,255,255,0.45);
}
.brand-name { font-family: var(--serif); font-weight: 600; font-size: 15px; color: var(--ink); }
.nav-links { display: flex; align-items: center; gap: 28px; }
.nav-link {
  font-size: 13px; font-weight: 500; color: var(--muted); text-decoration: none;
  cursor: pointer; transition: color .15s;
}
.nav-link:hover { color: var(--ink); }
.nav-right { display: flex; align-items: center; gap: 12px; }

/* ── BUTTONS ─────────────────────────────────────────────────────────────── */
.btn {
  font-family: var(--sans); font-weight: 600; font-size: 13px;
  border: none; cursor: pointer; border-radius: 8px;
  padding: 10px 20px; transition: all .15s ease; display: inline-flex; align-items: center; gap: 8px;
}
.btn:active { transform: scale(0.98); }
.btn-primary { background: var(--ink); color: var(--paper-raised); }
.btn-primary:hover { background: #2e2720; box-shadow: 0 4px 16px rgba(28,24,18,0.22); }
.btn-primary:disabled { background: #cfc6b3; color: #8a8270; cursor: not-allowed; box-shadow: none; }
.btn-amber { background: var(--amber); color: #fff; }
.btn-amber:hover { background: var(--amber-deep); box-shadow: 0 4px 16px rgba(194,118,28,0.35); }
.btn-ghost { background: transparent; color: var(--ink); border: 1.5px solid var(--line); }
.btn-ghost:hover { border-color: var(--ink); }
.btn-sm { padding: 7px 14px; font-size: 12px; border-radius: 7px; }
.btn-danger { background: var(--red); color: #fff; }
.btn-danger:hover { background: #7a2c20; }

/* ── CHIPS ───────────────────────────────────────────────────────────────── */
.chip {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 10px; border-radius: 20px; font-family: var(--mono);
  font-size: 10px; font-weight: 700; letter-spacing: 0.04em;
}
.chip-amber { background: var(--amber-pale); color: var(--amber-deep); }
.chip-green { background: #e4ede6; color: var(--green); }
.chip-muted { background: var(--line); color: var(--muted); }
.chip-red { background: #fbeae6; color: var(--red); }
.chip-ink { background: var(--ink); color: var(--paper); }

/* ── CARDS ───────────────────────────────────────────────────────────────── */
.card {
  background: var(--paper-raised); border: 1px solid var(--line);
  border-radius: 14px; overflow: hidden;
}
.card-hover { transition: box-shadow .2s, transform .2s; cursor: pointer; }
.card-hover:hover { box-shadow: 0 8px 32px rgba(28,24,18,0.1); transform: translateY(-2px); }

/* ── FORM ELEMENTS ───────────────────────────────────────────────────────── */
.field { margin-bottom: 18px; }
.field label {
  display: block; font-family: var(--mono); font-size: 10.5px; font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); margin-bottom: 7px;
}
.field input, .field select, .field textarea {
  width: 100%; padding: 11px 14px; border-radius: 9px;
  border: 1.5px solid var(--line); background: var(--paper);
  font-family: var(--sans); font-size: 14px; color: var(--ink);
  outline: none; transition: border-color .15s;
  -webkit-appearance: none;
}
.field input:focus, .field select:focus, .field textarea:focus { border-color: var(--amber); }
.field textarea { resize: vertical; min-height: 100px; line-height: 1.6; }
.field-note { font-size: 11.5px; color: var(--muted); margin-top: 5px; }

/* ── TABLES ──────────────────────────────────────────────────────────────── */
.table-wrap { background: var(--paper-raised); border: 1px solid var(--line); border-radius: 14px; overflow: auto; }
table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
th {
  text-align: left; padding: 12px 16px; font-family: var(--mono);
  font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--muted); border-bottom: 1px solid var(--line); background: var(--paper);
  white-space: nowrap;
}
td { padding: 13px 16px; border-bottom: 1px solid var(--line); vertical-align: middle; }
tr:last-child td { border-bottom: none; }
tr.clickable { cursor: pointer; transition: background .1s; }
tr.clickable:hover { background: var(--amber-pale); }

/* ── STAT CARDS ──────────────────────────────────────────────────────────── */
.stat-row { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 24px; }
.stat-card {
  background: var(--paper-raised); border: 1px solid var(--line); border-radius: 12px;
  padding: 18px 22px; flex: 1; min-width: 120px;
}
.stat-num { font-family: var(--serif); font-size: 30px; font-weight: 700; }
.stat-label { font-family: var(--mono); font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 4px; }

/* ── SLIDE PANEL ─────────────────────────────────────────────────────────── */
.panel-overlay {
  position: fixed; inset: 0; background: rgba(28,24,18,0.3); z-index: 200;
  opacity: 0; pointer-events: none; transition: opacity .25s;
}
.panel-overlay.open { opacity: 1; pointer-events: auto; }
.slide-panel {
  position: fixed; top: 0; right: 0; bottom: 0; width: 480px; max-width: 95vw;
  background: var(--paper-raised); border-left: 1px solid var(--line);
  box-shadow: -16px 0 48px -16px rgba(28,24,18,0.2);
  transform: translateX(100%); transition: transform .25s ease;
  z-index: 201; overflow-y: auto; padding: 28px;
}
.slide-panel.open { transform: translateX(0); }
.panel-close { cursor: pointer; font-family: var(--mono); font-size: 12px; color: var(--muted); }

/* ── PROGRESS RING ───────────────────────────────────────────────────────── */
.ring-wrap { position: relative; display: inline-flex; align-items: center; justify-content: center; }
.ring-wrap svg { transform: rotate(-90deg); }
.ring-track { fill: none; stroke: var(--line); }
.ring-fill { fill: none; stroke: var(--amber); stroke-linecap: round; transition: stroke-dashoffset .6s ease; }
.ring-text { position: absolute; font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--amber-deep); }

/* ── MINI PROGRESS BAR ───────────────────────────────────────────────────── */
.mini-bar { width: 80px; height: 5px; background: var(--line); border-radius: 3px; overflow: hidden; display: inline-block; vertical-align: middle; margin-right: 8px; }
.mini-bar-fill { height: 100%; background: var(--amber); border-radius: 3px; }

/* ── ALERT / ERROR ───────────────────────────────────────────────────────── */
.alert { padding: 12px 16px; border-radius: 9px; font-size: 13.5px; margin-bottom: 16px; }
.alert-error { background: #fbeae6; border: 1px solid #e7c3ba; color: var(--red); }
.alert-success { background: #e4ede6; border: 1px solid #bcd4c2; color: var(--green); }
.alert-warn { background: var(--amber-pale); border: 1px solid var(--amber); color: var(--amber-deep); }

/* ───────────────────────────────────────────────────────────────────────────
   RECRUITMENT PORTAL STYLES
─────────────────────────────────────────────────────────────────────────── */
.recruit-page { max-width: 1140px; margin: 0 auto; padding: 0 24px; }

/* Hero */
.hero {
  min-height: calc(100vh - 60px); display: flex; align-items: center;
  padding: 80px 0; position: relative;
}
.hero-inner { max-width: 720px; }
.hero-eyebrow {
  font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--amber-deep); margin-bottom: 20px;
}
.hero-headline {
  font-family: var(--serif); font-size: clamp(44px, 7vw, 80px); line-height: 1.05;
  font-weight: 600; margin-bottom: 24px; letter-spacing: -0.02em;
}
.hero-sub {
  font-size: 17px; line-height: 1.65; color: #3a3328; max-width: 560px; margin-bottom: 36px;
}
.hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 48px; }
.hero-ctas .btn { padding: 13px 26px; font-size: 14px; border-radius: 10px; }

/* Authority strip */
.authority-strip {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
  background: var(--line); border: 1px solid var(--line); border-radius: 14px; overflow: hidden;
  margin: 60px 0;
}
.auth-cell {
  background: var(--paper-raised); padding: 28px 26px;
}
.auth-icon { font-size: 22px; margin-bottom: 10px; }
.auth-title { font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--amber-deep); margin-bottom: 8px; }
.auth-text { font-size: 13.5px; line-height: 1.65; color: #3a3328; }

/* Section headers */
.section-eyebrow {
  font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--amber-deep); margin-bottom: 10px;
}
.section-headline { font-family: var(--serif); font-size: clamp(28px, 4vw, 42px); font-weight: 600; margin-bottom: 14px; }
.section-sub { font-size: 15.5px; color: #3a3328; line-height: 1.65; max-width: 580px; margin-bottom: 48px; }

/* Role cards */
.roles-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; margin-bottom: 48px; }
.role-card {
  background: var(--paper-raised); border: 1px solid var(--line); border-radius: 14px;
  padding: 24px; cursor: pointer; transition: all .2s;
}
.role-card:hover { box-shadow: 0 8px 32px rgba(28,24,18,0.1); transform: translateY(-2px); border-color: var(--amber); }
.role-code { font-family: var(--mono); font-size: 10.5px; font-weight: 700; color: var(--amber-deep); margin-bottom: 6px; }
.role-title { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
.role-identity { font-family: var(--mono); font-size: 10px; font-weight: 700; color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 10px; }
.role-purpose { font-size: 13px; color: #3a3328; line-height: 1.6; }
.role-card-footer { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; }

/* Standard cards */
.standard-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-bottom: 48px; }
.standard-card {
  background: var(--paper-raised); border: 1px solid var(--line); border-radius: 14px; padding: 26px;
}
.standard-num { font-family: var(--serif); font-size: 36px; font-weight: 300; color: var(--line); margin-bottom: 10px; }
.standard-title { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
.standard-desc { font-size: 13.5px; color: #3a3328; line-height: 1.65; }

/* Reject section */
.reject-section {
  background: var(--ink); border-radius: 16px; padding: 48px;
  margin: 0 0 60px; color: var(--paper);
}
.reject-section .section-eyebrow { color: var(--amber-pale); }
.reject-section .section-headline { color: var(--paper-raised); }
.reject-list { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px 32px; margin-bottom: 28px; }
.reject-list li { font-size: 13.5px; color: #c5bdb0; padding-left: 20px; position: relative; line-height: 1.5; }
.reject-list li::before { content: "✕"; position: absolute; left: 0; color: var(--amber); font-family: var(--mono); font-size: 11px; top: 2px; }
.reject-note { font-size: 13px; color: #a09688; border-top: 1px solid #2e2720; padding-top: 20px; line-height: 1.6; }

/* Process flow */
.process-flow { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 0; position: relative; margin-bottom: 60px; }
.process-step { text-align: center; padding: 24px 12px; position: relative; }
.process-step:not(:last-child)::after {
  content: "→"; position: absolute; right: -8px; top: 50%; transform: translateY(-50%);
  color: var(--amber); font-size: 18px;
}
.process-num { font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--amber-deep); margin-bottom: 6px; }
.process-title { font-size: 13px; font-weight: 600; margin-bottom: 4px; }
.process-desc { font-size: 11.5px; color: var(--muted); line-height: 1.5; }

/* Why cards */
.why-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-bottom: 48px; }
.why-card { background: var(--paper-raised); border: 1px solid var(--line); border-radius: 14px; padding: 26px; }
.why-icon { font-size: 24px; margin-bottom: 12px; }
.why-title { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
.why-desc { font-size: 13.5px; color: #3a3328; line-height: 1.65; }

/* Quote block */
.quote-block {
  background: var(--amber-pale); border: 1px solid var(--amber); border-radius: 14px;
  padding: 36px 40px; margin: 0 0 60px; position: relative;
}
.quote-mark { font-family: var(--serif); font-size: 80px; line-height: 0.5; color: var(--amber); position: absolute; top: 28px; left: 32px; }
.quote-text { font-family: var(--serif); font-size: clamp(16px, 2.2vw, 20px); line-height: 1.6; font-style: italic; padding-left: 32px; color: var(--amber-deep); }

/* Role detail page */
.role-detail-header { padding: 48px 0 32px; border-bottom: 1px solid var(--line); margin-bottom: 40px; }
.role-detail-breadcrumb { font-family: var(--mono); font-size: 11px; color: var(--muted); margin-bottom: 16px; cursor: pointer; }
.role-detail-breadcrumb:hover { color: var(--ink); }
.role-identity-desc { font-size: 17px; line-height: 1.65; color: #3a3328; max-width: 600px; margin-top: 12px; }
.role-sections { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 40px; }
.role-section-card { background: var(--paper-raised); border: 1px solid var(--line); border-radius: 12px; padding: 22px; }
.role-section-label { font-family: var(--mono); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--amber-deep); margin-bottom: 10px; }
.role-section-content { font-size: 13.5px; line-height: 1.7; color: #3a3328; }
.role-section-content ul { padding-left: 16px; }
.role-section-content li { margin-bottom: 5px; }

/* Filter tabs */
.filter-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 28px; }
.filter-tab {
  font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: 0.04em;
  padding: 7px 14px; border-radius: 20px; border: 1.5px solid var(--line); background: transparent;
  cursor: pointer; color: var(--muted); transition: all .15s;
}
.filter-tab:hover { border-color: var(--ink); color: var(--ink); }
.filter-tab.active { background: var(--ink); color: var(--paper); border-color: var(--ink); }

/* CTA section */
.cta-section { text-align: center; padding: 80px 0; }
.cta-section .section-headline { margin-bottom: 12px; }
.cta-section .section-sub { margin: 0 auto 32px; }

/* Page sections */
.page-section { padding: 72px 0; }
.page-section + .page-section { border-top: 1px solid var(--line); }

/* ───────────────────────────────────────────────────────────────────────────
   LEARNING PORTAL STYLES
─────────────────────────────────────────────────────────────────────────── */
/* Login */
.login-wrap { min-height: calc(100vh - 60px); display: flex; align-items: center; justify-content: center; padding: 24px; }
.login-card { width: 100%; max-width: 420px; background: var(--paper-raised); border: 1px solid var(--line); border-radius: 18px; padding: 40px 36px; box-shadow: 0 24px 60px -20px rgba(28,24,18,0.18); }
.login-eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--amber-deep); margin-bottom: 10px; font-weight: 700; }
.login-card h1 { font-family: var(--serif); font-size: 26px; line-height: 1.2; margin-bottom: 8px; }
.login-card p.desc { color: var(--muted); font-size: 14px; line-height: 1.55; margin-bottom: 28px; }
.admin-link { text-align: center; margin-top: 20px; font-size: 12px; color: var(--muted); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
.back-link { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); cursor: pointer; margin-bottom: 28px; text-decoration: none; }
.back-link:hover { color: var(--ink); }

/* Learning shell */
.learn-shell { display: flex; min-height: calc(100vh - 60px); }

/* Sidebar */
.learn-sidebar { width: 280px; flex-shrink: 0; border-right: 1px solid var(--line); background: var(--paper-raised); padding: 24px 0; overflow-y: auto; }
.sidebar-header { padding: 0 20px 18px; border-bottom: 1px solid var(--line); margin-bottom: 6px; }
.sidebar-greeting { font-family: var(--serif); font-size: 15px; font-weight: 600; margin-bottom: 10px; }
.progress-track { height: 5px; background: var(--line); border-radius: 4px; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, var(--amber-deep), var(--amber)); border-radius: 4px; transition: width .4s ease; }
.progress-label { font-family: var(--mono); font-size: 10px; color: var(--muted); margin-top: 7px; }
.sec-list { list-style: none; padding: 8px 10px; }
.sec-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px; border-radius: 9px; cursor: pointer;
  margin-bottom: 2px; transition: background .12s;
}
.sec-item:hover { background: var(--amber-pale); }
.sec-item.active { background: var(--ink); }
.sec-item.active .sec-title, .sec-item.active .sec-status { color: var(--paper-raised); }
.sec-dot { width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid var(--muted); flex-shrink: 0; }
.sec-dot.done { background: var(--green); border-color: var(--green); }
.sec-title { font-size: 12.5px; font-weight: 500; line-height: 1.3; }
.sec-status { font-family: var(--mono); font-size: 9.5px; color: var(--muted); display: block; margin-top: 2px; }

/* Main content */
.learn-main { flex: 1; padding: 40px 48px; max-width: 820px; overflow-y: auto; }

/* Dashboard */
.dash-subjects { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
.subject-card { background: var(--paper-raised); border: 1px solid var(--line); border-radius: 14px; padding: 26px; cursor: pointer; transition: all .2s; }
.subject-card:hover { box-shadow: 0 8px 32px rgba(28,24,18,0.1); transform: translateY(-2px); }
.subject-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
.subject-title { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
.subject-desc { font-size: 13px; color: var(--muted); line-height: 1.55; margin-bottom: 18px; }
.subject-meta { font-family: var(--mono); font-size: 10.5px; color: var(--muted); margin-bottom: 18px; }
.subject-card-footer { display: flex; justify-content: space-between; align-items: center; }

/* Reader */
.reader-eyebrow { font-family: var(--mono); font-size: 11px; color: var(--amber-deep); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 10px; }
.reader-h1 { font-family: var(--serif); font-size: 28px; font-weight: 600; margin-bottom: 28px; line-height: 1.2; }
.reader-body { background: var(--paper-raised); border: 1px solid var(--line); border-radius: 14px; padding: 30px 32px; margin-bottom: 20px; }
.clause-block { padding: 16px 0; border-bottom: 1px solid var(--line); }
.clause-block:first-child { padding-top: 0; }
.clause-block:last-child { border-bottom: none; padding-bottom: 0; }
.clause-label { font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--amber-deep); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 8px; }
.clause-block p { font-size: 14.5px; line-height: 1.75; color: #2b251c; margin-bottom: 10px; white-space: pre-line; }
.clause-block p:last-child { margin-bottom: 0; }

.gate-banner {
  background: var(--amber-pale); border: 1px solid var(--amber); border-radius: 10px;
  padding: 14px 18px; display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 18px; font-size: 13px;
}
.gate-timer { font-family: var(--mono); font-weight: 700; color: var(--amber-deep); font-size: 15px; }
.reader-actions { display: flex; gap: 12px; }

/* Quiz */
.quiz-progress-bar { height: 3px; background: var(--line); border-radius: 3px; margin-bottom: 28px; overflow: hidden; }
.quiz-progress-fill { height: 100%; background: var(--amber); border-radius: 3px; transition: width .3s; }
.q-counter { font-family: var(--mono); font-size: 11px; color: var(--muted); margin-bottom: 6px; }
.q-card { background: var(--paper-raised); border: 1px solid var(--line); border-radius: 14px; padding: 28px 30px; }
.q-text { font-size: 16px; font-weight: 600; line-height: 1.5; margin-bottom: 22px; }
.opt {
  display: flex; align-items: flex-start; gap: 12px;
  border: 1.5px solid var(--line); border-radius: 10px;
  padding: 13px 16px; margin-bottom: 10px; cursor: pointer;
  transition: all .12s; font-size: 14px; line-height: 1.55;
}
.opt:hover:not(.locked) { border-color: var(--amber); background: var(--amber-pale); }
.opt.selected { border-color: var(--amber); background: var(--amber-pale); }
.opt.correct { border-color: var(--green); background: #e4ede6; }
.opt.incorrect { border-color: var(--red); background: #fbeae6; }
.opt.locked { cursor: default; }
.opt-letter {
  font-family: var(--mono); font-weight: 700; font-size: 11px;
  width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid var(--line);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px;
}
.opt.selected .opt-letter { background: var(--amber); border-color: var(--amber); color: #fff; }
.opt.correct .opt-letter { background: var(--green); border-color: var(--green); color: #fff; }
.opt.incorrect .opt-letter { background: var(--red); border-color: var(--red); color: #fff; }
.opt-explain { margin-top: 10px; padding: 10px 14px; border-radius: 8px; font-size: 13px; line-height: 1.6; }
.opt-explain.right { background: #d4e8d8; color: #2c4a35; }
.opt-explain.wrong { background: #fbeae6; color: #7a2c20; }
.quiz-actions { margin-top: 24px; display: flex; gap: 12px; }

/* Result */
.result-banner { text-align: center; padding: 48px 24px; background: var(--paper-raised); border: 1px solid var(--line); border-radius: 16px; }
.result-score { font-family: var(--serif); font-size: 52px; font-weight: 700; margin: 8px 0; }
.result-pass { color: var(--green); }
.result-fail { color: var(--red); }
.result-msg { font-size: 14px; color: var(--muted); max-width: 380px; margin: 10px auto 28px; line-height: 1.6; }
.result-actions { display: flex; gap: 12px; justify-content: center; }

/* Admin */
.admin-main { padding: 36px 40px; max-width: 1200px; margin: 0 auto; }
.admin-tabs { display: flex; gap: 4px; margin-bottom: 28px; border-bottom: 1px solid var(--line); }
.admin-tab {
  font-family: var(--sans); font-size: 13px; font-weight: 600; cursor: pointer;
  padding: 10px 20px; border-bottom: 2px solid transparent; color: var(--muted); transition: all .15s;
}
.admin-tab:hover { color: var(--ink); }
.admin-tab.active { color: var(--ink); border-bottom-color: var(--amber); }

/* Toast */
.toast {
  position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
  background: var(--ink); color: var(--paper); padding: 12px 22px; border-radius: 10px;
  font-size: 13px; z-index: 500; opacity: 0; pointer-events: none;
  transition: opacity .25s; box-shadow: 0 8px 24px rgba(28,24,18,0.25); white-space: nowrap;
}
.toast.show { opacity: 1; }
.toast.error { background: var(--red); }
.toast.success { background: var(--green); }

/* Setup warning */
.setup-warn {
  position: fixed; top: 60px; left: 0; right: 0; z-index: 150;
  background: var(--amber-deep); color: #fff; text-align: center;
  font-family: var(--mono); font-size: 11.5px; padding: 9px 16px;
}

@media (max-width: 768px) {
  .topnav { padding: 0 16px; }
  .nav-links { display: none; }
  .recruit-page { padding: 0 16px; }
  .authority-strip { grid-template-columns: 1fr; }
  .role-sections { grid-template-columns: 1fr; }
  .learn-shell { flex-direction: column; }
  .learn-sidebar { width: 100%; border-right: none; border-bottom: 1px solid var(--line); }
  .learn-main { padding: 24px 16px; }
  .admin-main { padding: 20px 16px; }
  .process-flow { grid-template-columns: 1fr 1fr; }
  .process-step::after { display: none; }
  .reject-section { padding: 32px 24px; }
}
</style>
